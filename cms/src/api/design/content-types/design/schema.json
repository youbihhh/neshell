{
  "kind": "collectionType",
  "collectionName": "designs",
  "info": {
    "singularName": "design",
    "pluralName": "designs",
    "displayName": "House Design",
    "description": "Ready-made house designs shown on the House Designs page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "priceUsd": { "type": "integer", "required": true, "min": 0 },
    "bedrooms": { "type": "integer", "required": true, "min": 0 },
    "bathrooms": { "type": "decimal", "required": true, "min": 0 },
    "floors": { "type": "decimal", "required": true, "min": 1 },
    "sizeSqft": { "type": "integer", "required": true, "min": 0 },
    "image": { "type": "media", "multiple": false, "required": true, "allowedTypes": ["images"] }
  }
}
